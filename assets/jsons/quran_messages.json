[
  {
    "type": "quran",
    "text": "﴿قُلْ هُوَ اللَّهُ أَحَدٌ ۝ اللَّهُ الصَّمَدُ﴾",
    "subText": "[الإخلاص: 1-2]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَا خَلَقْتُ الْجِنَّ وَالْإِنْسَ إِلَّا لِيَعْبُدُونِ﴾",
    "subText": "[الذاريات: 56]"
  },
  {
    "type": "quran",
    "text": "﴿فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ ۝ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ﴾",
    "subText": "[الزلزلة: 7-8]"
  },
  {
    "type": "quran",
    "text": "﴿وَلَنَبْلُوَنَّكُمْ بِشَيْءٍ مِنَ الْخَوْفِ وَالْجُوعِ﴾",
    "subText": "[البقرة: 155]"
  },
  {
    "type": "quran",
    "text": "﴿فإِنَّ مَعَ الْعُسْرِ يُسْرًا ۝ إِنَّ مَعَ الْعُسْرِ يُسْرًا﴾",
    "subText": "[الشرح: 6-7]"
  },
  {
    "type": "quran",
    "text": "﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾",
    "subText": "[البقرة: 286]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾",
    "subText": "[البقرة: 20]"
  },
  {
    "type": "quran",
    "text": "﴿قَدْ أَفْلَحَ مَنْ زَكَّاهَا ۝ وَقَدْ خَابَ مَنْ دَسَّاهَا﴾",
    "subText": "[الشمس: 9-10]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ﴾",
    "subText": "[النحل: 90]"
  },
  {
    "type": "quran",
    "text": "﴿أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَنْ تَخْشَعَ قُلُوبُهُمْ﴾",
    "subText": "[الحديد: 16]"
  },
  {
    "type": "quran",
    "text": "﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ﴾",
    "subText": "[البقرة: 255]"
  },
  {
    "type": "quran",
    "text": "﴿يَا أَيُّهَا الَّذِينَ آمَنُوا قُوا أَنْفُسَكُمْ وَأَهْلِيكُمْ نَارًا﴾",
    "subText": "[التحريم: 6]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ مَعَ الصَّابِرِينَ﴾",
    "subText": "[البقرة: 153]"
  },
  {
    "type": "quran",
    "text": "﴿كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ﴾",
    "subText": "[آل عمران: 185]"
  },
  {
    "type": "quran",
    "text": "﴿رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا﴾",
    "subText": "[الفرقان: 74]"
  },
  {
    "type": "quran",
    "text": "﴿وَتِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ﴾",
    "subText": "[العنكبوت: 43]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا﴾",
    "subText": "[طه: 15]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾",
    "subText": "[البقرة: 173]"
  },
  {
    "type": "quran",
    "text": "﴿يَوْمَ تَبْيَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌ﴾",
    "subText": "[آل عمران: 106]"
  },
  {
    "type": "quran",
    "text": "﴿وَاصْبِرْ وَمَا صَبْرُكَ إِلَّا بِاللَّهِ﴾",
    "subText": "[النحل: 127]"
  },
  {
    "type": "quran",
    "text": "﴿اللَّهُ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ﴾",
    "subText": "[الرعد: 26]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ﴾",
    "subText": "[البقرة: 195]"
  },
  {
    "type": "quran",
    "text": "﴿وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ﴾",
    "subText": "[البقرة: 110]"
  },
  {
    "type": "quran",
    "text": "﴿وَقَدِمْنَا إِلَىٰ مَا عَمِلُوا مِنْ عَمَلٍ﴾",
    "subText": "[الفرقان: 23]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَا تَشَاءُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ﴾",
    "subText": "[الإنسان: 30]"
  },
  {
    "type": "quran",
    "text": "﴿فَاذْكُرُونِي أَذْكُرْكُمْ﴾",
    "subText": "[البقرة: 152]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا﴾",
    "subText": "[الطلاق: 2]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَا قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ﴾",
    "subText": "[الزمر: 67]"
  },
  {
    "type": "quran",
    "text": "﴿وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾",
    "subText": "[البقرة: 29]"
  },
  {
    "type": "quran",
    "text": "﴿وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ﴾",
    "subText": "[الأعراف: 156]"
  },
  {
    "type": "quran",
    "text": "﴿هُوَ يُحْيِي وَيُمِيتُ وَإِلَيْهِ تُرْجَعُونَ﴾",
    "subText": "[يونس: 56]"
  },
  {
    "type": "quran",
    "text": "﴿لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ﴾",
    "subText": "[الزمر: 53]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَا خَلَقْتُ الْجِنَّ وَالْإِنْسَ إِلَّا لِيَعْبُدُونِ﴾",
    "subText": "[الذاريات: 56]"
  },
  {
    "type": "quran",
    "text": "﴿لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ حَسَنَةٌ﴾",
    "subText": "[الأحزاب: 21]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ مَعَ الَّذِينَ اتَّقَوْا﴾",
    "subText": "[النحل: 128]"
  },
  {
    "type": "quran",
    "text": "﴿وَاللَّهُ خَيْرُ الرَّازِقِينَ﴾",
    "subText": "[الجمعة: 11]"
  },
  {
    "type": "quran",
    "text": "﴿وَإِلى اللَّهِ تُرْجَعُ الْأُمُورُ﴾",
    "subText": "[آل عمران: 109]"
  },
  {
    "type": "quran",
    "text": "﴿وَهُوَ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾",
    "subText": "[سبأ: 47]"
  },
  {
    "type": "quran",
    "text": "﴿فَإِنَّ مَعَ الْعُسْرِ يُسْرًا﴾",
    "subText": "[الشرح: 5]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَا تَوْفِيقِي إِلَّا بِاللَّهِ﴾",
    "subText": "[هود: 88]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّمَا يَخْشَى اللهَ مِنْ عِبَادِهِ الْعُلَمَاءُ﴾",
    "subText": "[فاطر: 28]"
  },
  {
    "type": "quran",
    "text": "﴿وَهُوَ السَّمِيعُ الْبَصِيرُ﴾",
    "subText": "[الشورى: 11]"
  },
  {
    "type": "quran",
    "text": "﴿وَقُلْ رَبِّ زِدْنِي عِلْمًا﴾",
    "subText": "[طه: 114]"
  },
  {
    "type": "quran",
    "text": "﴿وَإِلَٰهُكُمْ إِلَٰهٌ وَاحِدٌ ۖ لَّا إِلَٰهَ إِلَّا هُوَ الرَّحْمَٰنُ الرَّحِيمُ﴾",
    "subText": "[البقرة: 163]"
  },
  {
    "type": "quran",
    "text": "﴿وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ﴾",
    "subText": "[الطلاق: 3]"
  },
  {
    "type": "quran",
    "text": "﴿وَإِلَيْهِ يُرْجَعُ الْأَمْرُ كُلُّهُ﴾",
    "subText": "[هود: 123]"
  },
  {
    "type": "quran",
    "text": "﴿واللَّهَ غَالِبٌ عَلَىٰ أَمْرِهِ﴾",
    "subText": "[يوسف: 21]"
  },
  {
    "type": "quran",
    "text": "﴿إِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ﴾",
    "subText": "[التوبة: 120]"
  },
  {
    "type": "quran",
    "text": "﴿كُلُّ شَيْءٍ هَالِكٌ إِلَّا وَجْهَهُ﴾",
    "subText": "[القصص: 88]"
  },
  {
    "type": "quran",
    "text": "﴿وَهُوَ اللَّهُ فِي السَّمَاوَاتِ وَفِي الْأَرْضِ﴾",
    "subText": "[الأنعام: 3]"
  }
]